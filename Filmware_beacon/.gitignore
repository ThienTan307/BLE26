; ==========================================
; CẤU HÌNH PLATFORMIO CHO 3 DÒNG ESP32
; ==========================================

[platformio]
; Chọn môi trường mặc định (có thể đổi thành esp32, esp32c3, hoặc esp32s3)
default_envs = esp32c3

; ------------------------------------------
; 1. MÔI TRƯỜNG CHO ESP32 THƯỜNG (ESP-WROOM-32)
; ------------------------------------------
[env:esp32]
platform = espressif32
board = esp32dev
framework = arduino
monitor_speed = 115200

; ------------------------------------------
; 2. MÔI TRƯỜNG CHO ESP32-C3 (Dùng USB trực tiếp / Native USB)
; ------------------------------------------
[env:esp32c3]
platform = espressif32
board = esp32-c3-devkitm-1
framework = arduino
monitor_speed = 115200
; Cấu hình bắt buộc khi dùng USB trực tiếp trên ESP32-C3:
board_build.flash_mode = dio
build_flags = 
    -DARDUINO_USB_CDC_ON_BOOT=1
    -DARDUINO_USB_MODE=1

; ------------------------------------------
; 3. MÔI TRƯỜNG CHO ESP32-S3
; ------------------------------------------
[env:esp32s3]
platform = espressif32
board = esp32-s3-devkitc-1
framework = arduino
monitor_speed = 115200
board_build.usb_cdc_on_boot = 1